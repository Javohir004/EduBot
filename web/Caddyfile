# Production reverse proxy: automatic HTTPS for {$DOMAIN}, the Mini App (static files) and /api.
# DOMAIN is a bare host name in production (edubot.example.uz -> Let's Encrypt certificate);
# use "http://localhost" for a local HTTP-only test.
{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Telegram Web shows Mini Apps in an iframe, so no X-Frame-Options; frame-ancestors limits the parent.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-X-Frame-Options
		-Server
	}

	# Only the API is proxied: /actuator stays on the internal Docker network.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Vite assets have content hashes in their names.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: unknown paths fall back to index.html, which is never cached (new releases show up at once).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
