# Production settings for compose.prod.yaml. On the server: cp .env.production.example .env,
# fill in, chmod 600 .env. Never commit the filled-in file.

# Public host name (DNS A record -> server IP). Caddy gets a Let's Encrypt certificate for it.
DOMAIN=edubot.example.uz
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=admin@example.uz

# PostgreSQL (internal network only). Generate: openssl rand -base64 32
DB_USER=edubot
DB_PASSWORD=

# Production bot from @BotFather (NOT the development bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# At least 32 random bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# Comma-separated Telegram user ids that get SUPER_ADMIN
PLATFORM_ADMIN_TELEGRAM_IDS=

# Backups: age PUBLIC key (age1...). The private key stays off the server.
BACKUP_AGE_RECIPIENT=
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14
TZ=Asia/Tashkent

# Optional: run images pushed by CI instead of building on the server
# BACKEND_IMAGE=ghcr.io/javohir004/edubot-backend:latest
# WEB_IMAGE=ghcr.io/javohir004/edubot-web:latest
# BACKUP_IMAGE=ghcr.io/javohir004/edubot-backup:latest
