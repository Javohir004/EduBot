# Copy to .env and fill in. Never commit .env.

# PostgreSQL
DB_USER=edubot
DB_PASSWORD=change-me
# Used when the backend runs outside Docker (IDE / mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5433/edubot

# Telegram bot from @BotFather (use a separate bot for development)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=

# Comma-separated Telegram user ids that get SUPER_ADMIN
PLATFORM_ADMIN_TELEGRAM_IDS=

# HTTPS URL of the Mini App (tunnel URL in development)
MINI_APP_URL=
# Set to false to run the API without the bot (e.g. a second instance)
TELEGRAM_BOT_ENABLED=true

# Swagger UI at /swagger-ui.html (keep false in production)
API_DOCS_ENABLED=true
